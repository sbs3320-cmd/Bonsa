# 이 파일을 .env 로 복사하지 말고, 호스팅 서비스의 "환경 변수" 화면에 같은 이름으로 넣으세요.
# 비밀 값은 코드나 GitHub에 올리지 않습니다.

# PostgreSQL 접속 주소 (비워 두면 연습용 메모리 저장소를 쓰며, 서버가 꺼지면 계정이 사라집니다)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 로그인 토큰 서명용 비밀 값. 32자 이상의 아무 긴 문자열.
SESSION_SECRET=

# 실제 서비스에서는 production 으로 설정 (HTTPS 강제)
NODE_ENV=production

# 인원 제한 (기획서 기본값)
MAX_USERS=200
MAX_ONLINE=100

# 총관리자 계정의 로그인 아이디 (비밀번호는 적지 않습니다)
SUPERADMIN_USERNAME=

# 관리자 화면(/admin)의 2단계 인증을 초기화할 때만 yes 로 넣고, 다시 등록한 뒤에는 지웁니다
# ADMIN_2FA_RESET=yes

# 횟수 제한 (넣지 않으면 기본값)
# SIGNUP_PER_HOUR=30
# SIGNUP_PER_HOUR_ALL=80
# WS_PER_MIN=120
# API_PER_MIN=40
